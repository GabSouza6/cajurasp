{
  "name": "cajurasp",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
